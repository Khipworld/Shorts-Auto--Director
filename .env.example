# API 키는 이 파일이 아니라 실행 후 "설정 콘솔"(apiKeys.server.ts)에서 등록하는 것을 권장합니다.
# 콘솔을 쓰지 않고 환경변수로 직접 넣고 싶을 때만 아래를 채워서 .env.local로 복사해 사용하세요.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# 설정 콘솔(API 키 관리 화면) 자체 보호용
SETTINGS_CONSOLE_PASSWORD=
SETTINGS_ENCRYPTION_KEY=
